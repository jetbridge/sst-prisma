{
  "compilerOptions": {
    "strictNullChecks": true,
    "noEmit": true,
    "paths": {
      "@common/*": ["./common/src/*"],
      "@backend/*": ["./backend/src/*"]
    },
    "baseUrl": "."
  },
  "extends": "./tsconfig.base.json",
  "include": [
    "eslint.config.mjs",
    "stacks/**/*.ts",
    "backend/src/**/*.ts",
    "common/src/**/*.ts",
    "index.d.ts",
    "vite.config.ts",
    "backend/src/index.d.ts",
    "graphql/codegen.ts",
    "sst.config.ts",
    "testSetup.ts"
  ],
  "files": ["sst-env.d.ts", "reset.d.ts"],
  "exclude": ["node_modules", "web/public"]
}
